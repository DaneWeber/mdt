// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/typescript-node
{
	"name": "PNPM DevContainer",
	"image": "mcr.microsoft.com/devcontainers/typescript-node:5-24-trixie",
	"features": {
		"ghcr.io/devcontainers-extra/features/pnpm:2": {},
		"ghcr.io/devcontainers/features/github-cli:1": {},
		"ghcr.io/helpers4/devcontainer/pnpm-store:1": {}
	},
	"mounts": [
		"source=dnd354ever-claude-config,target=/home/node/.claude,type=volume",
		"source=dnd354ever-bashhistory,target=/commandhistory,type=volume"
	],
	// Fixes up volume ownership, installs Claude Code, and wires bash history to
	// the /commandhistory volume. Idempotent; re-runs on every start. Has to be
	// postStart rather than postCreate: the Claude Code install writes into
	// /home/node/.claude, which isn't writable until the chown in step 1, and
	// postCreateCommand runs *before* postStartCommand. See the script.
	"postStartCommand": "bash ${containerWorkspaceFolder}/.devcontainer/post-start.sh",
	"remoteEnv": {
		"CLAUDE_CONFIG_DIR": "/home/node/.claude",
		// Claude Code's launcher lives here. ~/.profile adds it, but only for
		// login shells -- set it explicitly so every terminal and task sees it.
		"PATH": "/home/node/.local/bin:${containerEnv:PATH}"
	}
}
